{
  "_doc": [
    "天玄架构治理策略（policy 即代码，借鉴 ZCode architecture-policy 思路）。",
    "本文件是根任务 architectureCheck 的唯一事实源：新增模块 / 调整依赖必须同步登记，",
    "否则依赖白名单检查会失败（防止未声明的模块依赖悄悄混入构建）。",
    "",
    "字段说明：",
    "- modules[].id: 模块标识（点分命名，如 core.model）",
    "- modules[].path: 模块目录（相对仓库根，/ 分隔）",
    "- modules[].requires: 允许依赖的模块 id 白名单（解析 build.gradle.kts 中所有 project(\":...\") 引用）",
    "- modules[].forbidBuildScript: 构建脚本中禁止出现的字符串（如模型层禁平台插件）",
    "- groups: 批量圈定模块集合，供 importBans 引用",
    "- importBans: 源码 import 黑名单（逐行匹配 src/main 下 .kt，pattern 为 Java 正则）",
    "- global.maxFileLines: 单文件行数上限；存量超限文件登记在基线文件中（棘轮：只许下调不许上涨）",
    "- global.baselineFile: 棘轮基线文件路径；用 architectureBaselineSync 任务维护",
    "- global.forbidCycles: 模块依赖图必须无环"
  ],
  "version": 1,
  "global": {
    "maxFileLines": 400,
    "forbidCycles": true,
    "baselineFile": ".architecture-baseline.json"
  },
  "groups": {
    "runtime": ["runtime", "runtime.browser"],
    "feature": [
      "feature.theme", "feature.components", "feature.home", "feature.chat",
      "feature.terminal", "feature.workspace", "feature.workflow", "feature.settings",
      "feature.developer", "feature.custom_iteration", "feature.onboarding",
      "feature.navigation", "feature.browser", "feature.git", "feature.preview",
      "feature.a2uipoc"
    ]
  },
  "importBans": [
    {
      "id": "model-purity",
      "pattern": "^import\\s+(android|androidx)\\.",
      "modules": ["core.model"],
      "message": "core:model 必须保持 Pure Kotlin，严禁引入 android/androidx（详见 ARCHITECTURE_RULES.md 第 1 节）"
    },
    {
      "id": "dao-direct-access",
      "pattern": "^import\\s+top\\.wkbin\\.tianxuan\\.core\\.database\\.[A-Za-z0-9_]*Dao\\b",
      "groups": ["feature", "runtime"],
      "modules": ["harness"],
      "note": "tools 与 app 当前为存量豁免（tools 内仓储实现直用 DAO、app 装配层注入 DAO）；迁移到仓储接口后应把二者纳入本规则",
      "message": "禁止直接导入 Room DAO，请依赖 core/database/PersistenceRepositories 暴露的仓储接口（详见 ARCHITECTURE_RULES.md 第 2 节）"
    }
  ],
  "modules": [
    {
      "id": "app",
      "path": "app",
      "requires": [
        "baselineprofile", "core.common", "core.model", "core.database", "core.network",
        "core.security", "core.datastore", "runtime", "project-template", "tools", "harness",
        "feature.components", "feature.chat", "feature.workspace", "feature.workflow",
        "feature.navigation", "feature.custom_iteration", "feature.onboarding",
        "feature.theme", "feature.git"
      ]
    },
    { "id": "baselineprofile", "path": "baselineprofile", "requires": [] },
    {
      "id": "core.common", "path": "core/common", "requires": [],
      "_doc": "通用工具层不依赖任何兄弟模块，防止核心层反向耦合"
    },
    {
      "id": "core.model", "path": "core/model", "requires": [],
      "forbidBuildScript": ["android.library", "koin.android", "androidx.core"],
      "_doc": "纯 Kotlin 数据模型：依赖白名单为空 + 构建脚本禁平台插件 + import 禁 android/androidx"
    },
    { "id": "core.database", "path": "core/database", "requires": ["core.model", "core.security"] },
    { "id": "core.datastore", "path": "core/datastore", "requires": ["core.model", "core.security"] },
    { "id": "core.network", "path": "core/network", "requires": ["core.model"] },
    { "id": "core.security", "path": "core/security", "requires": ["core.common"] },
    { "id": "core.browser", "path": "core/browser", "requires": ["core.model"] },
    {
      "id": "runtime", "path": "runtime", "requires": [
        "core.common", "core.model", "core.database", "core.datastore",
        "core.network", "project-template", "showerclient"
      ]
    },
    {
      "id": "runtime.browser", "path": "runtime/browser", "requires": [
        "core.common", "core.model", "core.datastore", "core.security", "core.browser"
      ]
    },
    { "id": "project-template", "path": "project-template", "requires": ["core.common"] },
    {
      "id": "tools", "path": "tools", "requires": [
        "core.common", "core.model", "core.database", "core.datastore",
        "core.network", "core.security", "runtime"
      ]
    },
    {
      "id": "harness", "path": "harness", "requires": [
        "core.common", "core.model", "core.browser", "runtime.browser",
        "core.database", "core.datastore", "core.network", "core.security",
        "runtime", "tools"
      ]
    },
    {
      "id": "showerclient", "path": "showerclient", "requires": [],
      "_doc": "源自 Operit（LGPL-3.0）的虚拟屏客户端库，保持来源边界：不依赖任何天玄内部模块"
    },
    { "id": "feature.theme", "path": "feature/theme", "requires": ["core.common", "core.model"] },
    {
      "id": "feature.components", "path": "feature/components",
      "requires": ["core.common", "core.model", "feature.theme"]
    },
    { "id": "feature.home", "path": "feature/home", "requires": ["core.datastore", "runtime"] },
    {
      "id": "feature.chat",
      "path": "feature/chat",
      "requires": ["core.common", "core.database", "core.datastore", "runtime", "harness", "tools", "feature.theme", "feature.a2uipoc"]
    },
    { "id": "feature.terminal", "path": "feature/terminal", "requires": ["core.datastore", "runtime"] },
    {
      "id": "feature.workspace",
      "path": "feature/workspace",
      "requires": ["core.database", "core.datastore", "project-template", "runtime", "tools", "harness", "feature.theme"]
    },
    {
      "id": "feature.workflow", "path": "feature/workflow",
      "requires": ["core.database", "runtime", "harness", "feature.theme"]
    },
    {
      "id": "feature.settings", "path": "feature/settings",
      "requires": ["core.database", "core.datastore", "core.network", "runtime", "tools", "harness", "feature.theme"]
    },
    {
      "id": "feature.developer", "path": "feature/developer",
      "requires": ["core.database", "core.datastore", "runtime", "tools"]
    },
    { "id": "feature.custom_iteration", "path": "feature/custom_iteration", "requires": [] },
    {
      "id": "feature.onboarding", "path": "feature/onboarding",
      "requires": ["core.datastore", "runtime", "tools"]
    },
    {
      "id": "feature.navigation",
      "path": "feature/navigation",
      "_doc": "顶层装配层：唯一允许依赖全部业务 feature 的模块",
      "requires": [
        "feature.theme", "feature.home", "feature.chat", "feature.terminal",
        "feature.workspace", "feature.workflow", "feature.settings", "feature.developer",
        "feature.custom_iteration", "feature.browser", "feature.git", "feature.preview",
        "feature.a2uipoc"
      ]
    },
    {
      "id": "feature.browser", "path": "feature/browser",
      "requires": ["core.browser", "core.datastore", "runtime.browser", "feature.theme"]
    },
    {
      "id": "feature.git", "path": "feature/git",
      "requires": ["core.security", "runtime", "harness", "feature.theme"]
    },
    { "id": "feature.preview", "path": "feature/preview", "requires": ["feature.theme"] },
    {
      "id": "feature.a2uipoc",
      "path": "feature/a2uipoc",
      "_doc": "A2UI（Agent-to-UI）渲染器 PoC：官方 androidx.a2ui 1.0.0-alpha01 仅允许在本模块使用，对外只暴露 A2uiPocSurfaceCard / A2uiPocScreen",
      "requires": ["harness", "feature.theme", "feature.components"]
    }
  ]
}
