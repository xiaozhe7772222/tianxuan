{
  "schemaVersion": 1,
  "id": "cc-switch",
  "name": "CC-Switch 智能体中枢",
  "description": "Claude Code、OpenClaw、Hermes Agent 与 Codex 统一多模型切源、版本管理与本地协议代理中枢",
  "version": "1.0.0",
  "latestVersion": "1.0.0",
  "publisher": "TianXuan Ecosystem",
  "category": "AI_AGENT",
  "launchType": "service",
  "servicePort": 19870,
  "servicePath": "/",
  "architectures": ["ARM64"],
  "permissions": ["NETWORK", "WORKSPACE_READ", "WORKSPACE_WRITE", "LOCAL_WEB"],
  "updateStrategy": "REINSTALL",
  "source": "LOCAL",
  "offlineOnly": true,
  "installMethod": "LOCAL_PACKAGE",
  "installSteps": [
    "/bin/sh \"$TIANXUAN_PLUGIN_PAYLOAD/scripts/install.sh\""
  ],
  "uninstallSteps": [
    "/bin/sh \"$TIANXUAN_PLUGIN_PAYLOAD/scripts/uninstall.sh\""
  ],
  "launchCommand": "cc-switch-daemon --port 19870 --data-dir /opt/tianxuan/data/cc-switch",
  "verifyCommand": "/bin/sh \"$TIANXUAN_PLUGIN_PAYLOAD/scripts/verify.sh\"",
  "commandLinks": ["cc-switch-daemon"],
  "environment": {
    "CC_SWITCH_PORT": "19870",
    "CC_SWITCH_DATA_DIR": "/opt/tianxuan/data/cc-switch"
  }
}
